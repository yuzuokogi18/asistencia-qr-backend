# Configuración del Entorno de Producción en la Nube
PORT=3001
NODE_ENV=production

# URL de conexión a la Base de Datos MySQL en la nube (ej: TiDB Cloud Serverless con SSL)
# Formato: mysql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?sslaccept=strict
DATABASE_URL="mysql://root:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/asistencia_prepa_db?sslaccept=strict"

# Seguridad y Autenticación JWT (Generar una cadena aleatoria de 32+ caracteres)
JWT_SECRET="clave_secreta_super_segura_produccion_2026_telebachillerato"
JWT_EXPIRES_IN="24h"

# Datos Institucionales de la Escuela
SCHOOL_NAME="Telebachillerato Comunitario"
SCHOOL_LEMA="Excelencia y Compromiso Educativo"
SCHOOL_CYCLE="2026-2027"
TIMEZONE="America/Mexico_City"

# Dominio del Frontend en Vercel permitido para CORS
FRONTEND_URL="https://tu-proyecto.vercel.app"
